# =============================================================
# QA Copilot · variables de entorno
# Copiar a .env (cp .env.example .env) y completar. Nunca versionar .env.
# =============================================================

# --- Base de datos (PostgreSQL 16) ---------------------------
POSTGRES_DB=qa_copilot
POSTGRES_USER=qa_copilot
# Cambiar por una contraseña propia. Si se cambia, actualizar también DATABASE_URL.
POSTGRES_PASSWORD=cambiar_esto

# URL que usa el backend (host "db" = servicio de la red interna de Docker).
DATABASE_URL=postgresql+psycopg://qa_copilot:cambiar_esto@db:5432/qa_copilot

# --- Comunicación frontend → backend -------------------------
# URL interna que usa Streamlit para llamar a la API (red interna de Docker).
API_BASE_URL=http://backend:8000
# URL pública de la API, solo para mostrar el enlace a /docs en "Acerca de".
API_PUBLIC_URL=http://localhost:8000

# --- Puertos publicados en el host ---------------------------
# Configurables para no chocar con otros servicios del servidor.
BACKEND_PORT=8000
FRONTEND_PORT=8501

# --- Backend ---------------------------------------------------
# Carga las 3 historias de ejemplo si la base está vacía.
SEED_EXAMPLES=true
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Catálogo de pasos del SUT (RF-02), relativo a la carpeta del backend. Si es inválido,
# el backend no inicia. Normalmente no hace falta cambiarlo.
# CATALOGO_PATH=catalogo/saucedemo.yaml

# --- LLM (RF-03) ---------------------------------------------
# Proveedores: openrouter o deepseek (API compatible con OpenAI) o demo (respuestas
# pregrabadas para las historias de ejemplo, sin llamar a la red; RF-10).
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
# Versión con fecha: el modelo no cambia sin aviso.
LLM_MODEL=deepseek/deepseek-v4.1-flash-1017
# Para la API directa de DeepSeek: LLM_PROVIDER=deepseek, LLM_BASE_URL=https://api.deepseek.com
# y LLM_MODEL=deepseek-chat.
# Clave secreta: solo en .env o en las variables de Dokploy, nunca en el repo.
LLM_API_KEY=
# Límite diario de generaciones (RNF-08). 0 = sin límite.
DAILY_GENERATION_LIMIT=30

# --- Sistema bajo prueba (RF-07): URL base de las ejecuciones -
# SUT_BASE_URL=https://www.saucedemo.com
