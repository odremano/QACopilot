# =============================================================
# QA Copilot · variables de entorno
# Copiar a .env (cp .env.example .env) y completar. Nunca versionar .env.
# =============================================================

# --- Base de datos (PostgreSQL 16) ---------------------------
POSTGRES_DB=qa_copilot
POSTGRES_USER=qa_copilot
# Cambiar por una contraseña propia. Si se cambia, actualizar también DATABASE_URL.
POSTGRES_PASSWORD=cambiar_esto

# URL que usa el backend (host "db" = servicio de la red interna de Docker).
DATABASE_URL=postgresql+psycopg://qa_copilot:cambiar_esto@db:5432/qa_copilot

# --- Comunicación frontend → backend -------------------------
# URL interna que usa Streamlit para llamar a la API (red interna de Docker).
API_BASE_URL=http://backend:8000
# URL pública de la API, solo para mostrar el enlace a /docs en "Acerca de".
API_PUBLIC_URL=http://localhost:8000

# --- Puertos publicados en el host ---------------------------
# Configurables para no chocar con otros servicios del servidor.
BACKEND_PORT=8000
FRONTEND_PORT=8501

# --- Backend ---------------------------------------------------
# Carga las 3 historias de ejemplo si la base está vacía.
SEED_EXAMPLES=true
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- LLM (se usa a partir de S4) -----------------------------
# Proveedores previstos: deepseek, ollama, demo.
# LLM_PROVIDER=deepseek
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# Clave secreta: solo en .env o en las variables de Dokploy, nunca en el repo.
# LLM_API_KEY=
# Límite diario de generaciones (RNF-08).
# DAILY_GENERATION_LIMIT=30

# --- Sistema bajo prueba (se usa a partir de S5) -------------
# SUT_BASE_URL=https://www.saucedemo.com
